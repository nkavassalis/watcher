# Copy to .env and fill in. .env is gitignored; this file is the template.
# Placeholder values only — never put a real key in a tracked file.
# (These are read from the real environment by watcher/config.py; the rest of
# the config lives in config.json — see README.)

# OpenAI-compatible endpoint used for onboarding ("fit the detector to this page")
# WATCHER_LLM_BASE_URL=http://llm-host:8000/v1
# WATCHER_LLM_MODEL=            # blank = first model the endpoint serves
# WATCHER_LLM_API_KEY=          # only if your endpoint requires one

# Where Gmail OAuth files live (client_secret.json + tokens.json), for
# change-notification email. Same layout sparky's send_mail.py uses.
# WATCHER_GMAIL_DIR=~/.gmail

# Path to the config JSON (default: ./config.json)
# WATCHER_CONFIG=config.json
